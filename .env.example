# Copy this file to .env. Never commit the real .env file.
UNITREE_REGION=cn
# Optional cached IP. Leave blank to rediscover automatically after Wi-Fi changes.
UNITREE_ROBOT_IP=
UNITREE_AES_128_KEY=
UNITREE_SERIAL_NUMBER=

# Optional fleet members; continue with UNITREE_ROBOT_3_... up to 16.
UNITREE_ROBOT_2_LABEL=Robot 2
UNITREE_ROBOT_2_IP=
UNITREE_ROBOT_2_SERIAL_NUMBER=
UNITREE_ROBOT_2_AES_128_KEY=
